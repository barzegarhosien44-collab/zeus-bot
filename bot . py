def get_db():
    conn = sqlite3.connect(DB_FILE)
    conn.row_factory = sqlite3.Row
    return conn


def init_db():
    conn = get_db()

    conn.execute("""
        CREATE TABLE IF NOT EXISTS group_users (
            chat_id INTEGER NOT NULL,
            user_id INTEGER NOT NULL,
            name TEXT NOT NULL,
            coins INTEGER NOT NULL DEFAULT 0,
            wins INTEGER NOT NULL DEFAULT 0,
            PRIMARY KEY (chat_id, user_id)
        )
    """)

    conn.execute("""
        CREATE TABLE IF NOT EXISTS games (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            chat_id INTEGER NOT NULL,
            game_type TEXT NOT NULL,
            creator_id INTEGER NOT NULL,
            creator_name TEXT NOT NULL,
            player2_id INTEGER,
            player2_name TEXT,
            stake INTEGER NOT NULL,
            status TEXT NOT NULL DEFAULT 'waiting',
            message_id INTEGER,
            board TEXT DEFAULT '.........',
            turn_user_id INTEGER,
            creator_side TEXT,
            player2_side TEXT,
            created_at INTEGER NOT NULL
        )
    """)

    conn.commit()
    conn.close()


def ensure_user(chat_id, user):
    conn = get_db()

    conn.execute("""
        INSERT INTO group_users (chat_id, user_id, name, coins, wins)
        VALUES (?, ?, ?, 0, 0)
        ON CONFLICT(chat_id, user_id)
        DO UPDATE SET name = excluded.name
    """, (
        chat_id,
        user.id,
        user.full_name
    ))

    conn.commit()
    conn.close()


def get_balance(chat_id, user_id):
    conn = get_db()

    row = conn.execute("""
        SELECT coins
        FROM group_users
        WHERE chat_id = ? AND user_id = ?
    """, (chat_id, user_id)).fetchone()

    conn.close()

    if not row:
        return 0

    return row["coins"]


def add_coins(chat_id, user_id, amount):
    conn = get_db()

    conn.execute("""
        UPDATE group_users
        SET coins = coins + ?
        WHERE chat_id = ? AND user_id = ?
    """, (amount, chat_id, user_id))

    conn.commit()
    conn.close()


def remove_coins(chat_id, user_id, amount):
    conn = get_db()

    conn.execute("""
        UPDATE group_users
        SET coins = CASE
            WHEN coins >= ? THEN coins - ?
            ELSE 0
        END
        WHERE chat_id = ? AND user_id = ?
    """, (amount, amount, chat_id, user_id))

    conn.commit()
    conn.close()


