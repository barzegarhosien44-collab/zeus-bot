def get_leaderboard(chat_id, field):
    if field not in ("coins", "wins"):
        return []

    conn = get_db()

    rows = conn.execute(f"""
        SELECT name, coins, wins
        FROM group_users
        WHERE chat_id = ?
        ORDER BY {field} DESC
        LIMIT 10
    """, (chat_id,)).fetchall()

    conn.close()

    return rows


def get_game(game_id):
    conn = get_db()

    row = conn.execute("""
        SELECT *
        FROM games
        WHERE id = ?
    """, (game_id,)).fetchone()

    conn.close()

    return row


def has_active_game(chat_id, user_id):
    conn = get_db()

    row = conn.execute("""
        SELECT id
        FROM games
        WHERE chat_id = ?
          AND (creator_id = ? OR player2_id = ?)
          AND status IN ('waiting', 'playing')
        LIMIT 1
    """, (
        chat_id,
        user_id,
        user_id
    )).fetchone()

    conn.close()

    return row is not None


