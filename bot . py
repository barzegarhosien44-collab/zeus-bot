async def is_owner(update, context):
    try:
        chat_id = update.effective_chat.id
        user_id = update.effective_user.id

        member = await context.bot.get_chat_member(
            chat_id,
            user_id
        )

        return member.status == "creator"

    except Exception:
        return False


