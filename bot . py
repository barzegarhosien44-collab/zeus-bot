def xo_board(game_id, board):
    symbols = {
        "X": "❌",
        "O": "⭕",
        ".": "⬜"
    }

    keyboard = []

    for row in range(3):
        buttons = []

        for col in range(3):
            index = row * 3 + col

            buttons.append(
                InlineKeyboardButton(
                    symbols[board[index]],
                    callback_data=f"xo_move:{game_id}:{index}"
                )
            )

        keyboard.append(buttons)

    return InlineKeyboardMarkup(keyboard)


